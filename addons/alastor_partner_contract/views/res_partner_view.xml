<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Partner -->
        <record id="view_partner_form_inherith" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.1</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <!-- <xpath expr="/form/sheet/div/field[@name='ministry']" position="after">
                <field name="subordination_level_id" placeholder="Nivel de subordinación" attrs="{'invisible':
        [('is_company','=',False)]}"/>
            </xpath> -->
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="is_supplier_logistics" invisible="1" />
                    <field
            name="partner_role"
            widget="statusbar"
            options="{'clickable': True}"
          />
                </xpath>
            </field>
        </record>

        <record id="action_supplier_logistics_form" model="ir.actions.act_window">
            <field name="name">Vendors Logistics</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="domain">[('is_supplier_logistics', '=', True)]</field>
            <field name="view_mode">kanban,tree,form</field>
            <field
        name="context"
      >{'res_partner_search_mode': 'supplier', 'default_is_company': True,
        'default_is_supplier_logistics': True, 'default_partner_role': 'logistics_supplier'}</field>
            <field name="filter" eval="True" />
            <field name="help" type="html">
                <p
          class="o_view_nocontent_smiling_face"
        >Create a new vendor in your address book</p>
                <p>Odoo helps you easily track all activities related to a vendor.</p>
            </field>
        </record>

        <record id="view_partner_tree_inherit_role" model="ir.ui.view">
            <field name="name">res.partner.tree.inherit.role</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='short_description']" position="after">
                    <field name="partner_role" string="Tipo" />
                </xpath>
            </field>
        </record>
        <!-- Local actions (duplicated behavior from account module) -->
        <record
      id="res_partner_action_customer_contract_alastor"
      model="ir.actions.act_window"
    >
            <field name="name">Cliente</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[('partner_role','in',['customer','both'])]</field>
            <field
        name="context"
      >{'search_default_customer': 1,'res_partner_search_mode': 'customer', 'default_is_company': True, 'default_customer_rank': 1, 'default_partner_role': 'customer'}</field>
            <field name="help" type="html">
                <p
          class="o_view_nocontent_smiling_face"
        >Create a new customer in your address book</p>
                <p>Odoo helps you easily track all activities related to a customer.</p>
            </field>
        </record>

        <record
      id="res_partner_action_supplier_contract_alastor"
      model="ir.actions.act_window"
    >
            <field name="name">Proveedor</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[('partner_role','in',['supplier','both'])]</field>
            <field
        name="context"
      >{'search_default_supplier': 1,'res_partner_search_mode': 'supplier', 'default_is_company': True, 'default_supplier_rank': 1, 'default_partner_role': 'supplier'}</field>
            <field name="help" type="html">
                <p
          class="o_view_nocontent_smiling_face"
        >Create a new supplier in your address book</p>
                <p>Odoo helps you easily track all activities related to a supplier.</p>
            </field>
        </record>
    </data>
</odoo>
